{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "overrides": [
    {
      "includes": ["**/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nestjs/*",
                      "@mikro-orm/*",
                      "aws-sdk",
                      "@aws-sdk/*",
                      "pino",
                      "zod",
                      "**/application/**",
                      "**/infra/**"
                    ]
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Number": "Dinheiro nunca usa number (D2 CLAUDE.md). Use Money.",
                  "parseInt": "Dinheiro nunca usa parseInt (D2 CLAUDE.md). Use Money.",
                  "parseFloat": "Dinheiro nunca usa parseFloat (D2 CLAUDE.md). Use Money.",
                  "Math": "Dinheiro nunca usa Math.* (D2 CLAUDE.md, D14.8). Use Money."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/load/lib/money.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Number": "Dinheiro nunca usa number (D2 CLAUDE.md). Use centavos bigint.",
                  "parseInt": "Dinheiro nunca usa parseInt (D2 CLAUDE.md). Use centavos bigint.",
                  "parseFloat": "Dinheiro nunca usa parseFloat (D2 CLAUDE.md). Use centavos bigint.",
                  "Math": "Dinheiro nunca usa Math.* (D2 CLAUDE.md). Use centavos bigint."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@mikro-orm/*",
                      "aws-sdk",
                      "@aws-sdk/*",
                      "pino",
                      "**/infra/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/modules/accounting/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nestjs/*",
                      "@mikro-orm/*",
                      "aws-sdk",
                      "@aws-sdk/*",
                      "pino",
                      "zod",
                      "**/application/**",
                      "**/infra/**",
                      "**/wagering/**"
                    ],
                    "message": "D27.8: o domínio do accounting não importa camadas externas nem o núcleo."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/modules/accounting/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@mikro-orm/*",
                      "aws-sdk",
                      "@aws-sdk/*",
                      "pino",
                      "**/infra/**",
                      "**/wagering/**"
                    ],
                    "message": "D27.8: a aplicação do accounting não importa infraestrutura nem o núcleo."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/modules/accounting/infra/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/wagering/**",
                      "!**/wagering/infra/messaging/sqs-consumer",
                      "!**/wagering/infra/messaging/sqs-wager-queue",
                      "!**/wagering/infra/messaging/consumer-policy",
                      "!**/wagering/infra/observability/gauges"
                    ],
                    "message": "D27.8: do núcleo, o accounting só importa o laço genérico (sqs-consumer, sqs-wager-queue, consumer-policy, gauges)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/modules/realtime/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@nestjs/*",
                      "@mikro-orm/*",
                      "aws-sdk",
                      "@aws-sdk/*",
                      "pino",
                      "zod",
                      "**/application/**",
                      "**/infra/**",
                      "**/wagering/**",
                      "**/accounting/**"
                    ],
                    "message": "D28.1: o domínio do realtime não importa camadas externas, o núcleo nem o accounting."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/modules/realtime/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@mikro-orm/*",
                      "aws-sdk",
                      "@aws-sdk/*",
                      "pino",
                      "**/infra/**",
                      "**/wagering/**",
                      "**/accounting/**"
                    ],
                    "message": "D28.1: a aplicação do realtime não importa infraestrutura, o núcleo nem o accounting."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/modules/realtime/infra/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@mikro-orm/*", "**/wagering/**", "**/accounting/**", "**/shared/orm/**"],
                    "message": "D28.1: o realtime não usa banco nem importa o núcleo ou o accounting; o contrato é o envelope do §11."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=wagering
DB_USER=wagering_app
DB_PASSWORD=wagering_app
# Papel dono: só as migrations o usam (D7.3)
DB_MIGRATION_USER=wagering_owner
DB_MIGRATION_PASSWORD=wagering_owner

AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
SNS_TOPIC_WAGERING_EVENTS=wagering-events.fifo
QUEUE_WAGER_TRANSACTIONS=wager-transactions.fifo
QUEUE_WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
QUEUE_WAGERING_EVENTS_AUDITOR=wagering-events-auditor.fifo
QUEUE_WAGERING_EVENTS_AUDITOR_DLQ=wagering-events-auditor-dlq.fifo

# Publisher da outbox (D9.6, D20.5): o timeout do SNS tem de ser menor que o lease.
OUTBOX_LEASE_MS=30000
OUTBOX_SNS_REQUEST_TIMEOUT_MS=10000

# Worker de pendentes (D18.2, D21.6): lote × lock_timeout (2 s) < lease.
PENDING_LEASE_MS=30000
PENDING_BATCH_SIZE=10
# Consumidor SQS (D19.6, D21.6): mensagens × (2 s + 5 s) ≤ visibilidade; até 10 por receive.
CONSUMER_VISIBILITY_TIMEOUT_S=120
CONSUMER_MAX_MESSAGES=10

# Prazo de cada requisição HTTP e da drenagem no shutdown (D5, D8.6, D21.3).
HTTP_REQUEST_TIMEOUT_MS=10000
# application_name das conexões (D21.1); sem valor, o nome do processo.
# DB_APPLICATION_NAME=api-local

HEALTH_CHECK_TIMEOUT_MS=1000
CURRENCIES=BRL,USD

# Emissor dos tokens (D10.1, D23.3), só o processo api: o Keycloak do Compose
# de dev, com o emissor fixo no KC_HOSTNAME (localhost:8080).
AUTH_ISSUER=http://localhost:8080/realms/wagering
AUTH_AUDIENCE=wagering-api
AUTH_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
# JWKS sem resposta nesse prazo → 503 (D16.16).
AUTH_JWKS_TIMEOUT_MS=5000

# Só o `bun run acceptance` (D23.7), opcionais: a api (o nginx) e o Keycloak do
# Compose de dev. Os valores abaixo são os padrões.
# ACCEPTANCE_API_URL=http://localhost:3000
# ACCEPTANCE_KEYCLOAK_URL=http://localhost:8080

{
  "name": "distributed-wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p load/k6/tsconfig.json",
    "lint": "biome lint ./src ./test/support ./test/unit ./test/integration ./test/concurrency ./test/e2e ./scripts ./migrations ./proofs ./load",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --env-file=.env.test --preload ./test/support/integration-setup.ts test/integration",
    "test:concurrency": "bun test --env-file=.env.test --preload ./test/support/integration-setup.ts test/concurrency",
    "test:e2e": "bun test --env-file=.env.test --preload ./test/support/integration-setup.ts test/e2e",
    "test:repeat": "bun run scripts/test-repeat.ts",
    "test:proofs": "bun run scripts/proofs.ts",
    "proofs:check": "bun run scripts/proofs-apply-check.ts",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "migration:verify": "bun --env-file=.env.test scripts/migration-verify.ts",
    "check": "bun run typecheck && bun run lint && bun run proofs:check && bun run test:unit && bun run migration:verify && bun run test:integration && bun run test:concurrency && bun run test:e2e",
    "infra:up": "docker compose up -d --build",
    "infra:down": "docker compose down",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "infra:test:down": "docker compose -f docker-compose.test.yml down -v",
    "acceptance": "bun run scripts/acceptance.ts",
    "test:load": "bun run scripts/load-test.ts",
    "accounting:reconcile": "docker compose run --rm --no-deps -e DB_USER=wagering_app -e DB_PASSWORD=wagering_app -e DB_ACCOUNTING_USER=accounting_app -e DB_ACCOUNTING_PASSWORD=accounting_app accounting-consumer scripts/accounting-reconcile.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@nestjs/testing": "^12.3.2",
    "@types/bun": "1.4.4",
    "@types/express": "^5.0.6",
    "@types/k6": "2.3.0",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1160.0",
    "@aws-sdk/client-sqs": "^3.1160.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@smithy/node-http-handler": "^4.14.0",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}

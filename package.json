{
  "name": "distributed-wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint ./src ./test/support ./test/unit ./test/integration ./test/concurrency ./scripts",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --env-file=.env.test test/integration",
    "test:concurrency": "bun test --env-file=.env.test test/concurrency",
    "check": "bun run typecheck && bun run lint && bun run test:unit && bun run test:integration && bun run test:concurrency",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "infra:test:down": "docker compose -f docker-compose.test.yml down -v",
    "acceptance": "bun run scripts/acceptance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@nestjs/testing": "^12.3.2",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1160.0",
    "@aws-sdk/client-sqs": "^3.1160.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@smithy/node-http-handler": "^4.14.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
